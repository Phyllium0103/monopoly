# Supabase 專案設定（Project Settings → API）
# 只放公開的 Project URL 與 publishable（或 anon）key；service_role / secret key 絕對不能放在前端。
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# 選填：Edge Function 在資料庫所在區域執行可大幅減少延遲（Project Settings → General → Region，例如 ap-south-1）
VITE_SUPABASE_REGION=ap-south-1
